@prefix wis:  <https://datakeep64.github.io/wis/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# =====================================================================
# Wildlife Intelligence System - ontology (TBox: schema + controlled vocab)
# Instances (species, zones) live in species_seed.ttl, generated by
# build_seed.py from species.csv / zones.csv (+ IUCN data from GBIF).
# =====================================================================

<https://datakeep64.github.io/wis/ontology> a owl:Ontology ;
    rdfs:label "Wildlife Intelligence System ontology"@en ;
    rdfs:comment "Species, habitats, conservation status, threats, zones, camera-trap sightings and alerts for Singapore and Peninsular Malaysia."@en .

# ---------------------------------------------------------------- classes
wis:Taxon        a owl:Class ; rdfs:label "Taxon"@en .
wis:Species      a owl:Class ; rdfs:subClassOf wis:Taxon ; rdfs:label "Species"@en .
wis:Subspecies   a owl:Class ; rdfs:subClassOf wis:Taxon ; rdfs:label "Subspecies"@en .

wis:Habitat            a owl:Class ; rdfs:label "Habitat"@en .
wis:ConservationStatus a owl:Class ; rdfs:label "IUCN Red List category"@en .
wis:Threat             a owl:Class ; rdfs:label "Threat"@en .

wis:Zone          a owl:Class ; rdfs:label "Zone"@en ;
    rdfs:comment "A geographic unit that camera traps and alerts refer to."@en .
wis:ProtectedArea a owl:Class ; rdfs:subClassOf wis:Zone ; rdfs:label "Protected area"@en .
wis:Country       a owl:Class ; rdfs:label "Country"@en .

wis:CameraTrap a owl:Class ; rdfs:label "Camera trap"@en .

# A Sighting is the hand-off point from perception to reasoning.
wis:Sighting          a owl:Class ; rdfs:label "Sighting"@en .
wis:AnimalSighting    a owl:Class ; rdfs:subClassOf wis:Sighting ; rdfs:label "Animal sighting"@en .
wis:PersonDetection   a owl:Class ; rdfs:subClassOf wis:Sighting ; rdfs:label "Person detection"@en ;
    rdfs:comment "MegaDetector 'person' class; treated as a possible intrusion signal."@en .
wis:VehicleDetection  a owl:Class ; rdfs:subClassOf wis:Sighting ; rdfs:label "Vehicle detection"@en .

wis:Alert        a owl:Class ; rdfs:label "Alert"@en .
wis:AlertPriority a owl:Class ; rdfs:label "Alert priority"@en .

# Defined class (OWL): a taxon whose status is CR, EN or VU is Threatened.
wis:ThreatenedTaxon a owl:Class ;
    rdfs:label "Threatened taxon"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( wis:Taxon
            [ a owl:Restriction ; owl:onProperty wis:hasIUCNStatus ;
              owl:someValuesFrom [ a owl:Class ; owl:oneOf ( wis:CR wis:EN wis:VU ) ] ] )
    ] .

# ------------------------------------------------------- object properties
wis:subspeciesOf a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain wis:Subspecies ; rdfs:range wis:Species .
wis:hasIUCNStatus a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain wis:Taxon ; rdfs:range wis:ConservationStatus .
wis:livesIn a owl:ObjectProperty ;
    rdfs:domain wis:Taxon ; rdfs:range wis:Habitat ;
    rdfs:comment "Species-habitat association. Link prediction (PyKEEN) targets this relation."@en .
wis:threatenedBy a owl:ObjectProperty ;
    rdfs:domain wis:Taxon ; rdfs:range wis:Threat .
wis:occursInCountry a owl:ObjectProperty ;
    rdfs:domain wis:Taxon ; rdfs:range wis:Country .
wis:observedIn a owl:ObjectProperty ;
    rdfs:domain wis:Taxon ; rdfs:range wis:Zone ;
    rdfs:comment "Populated from GBIF/iNaturalist occurrences or sightings (Phase B)."@en .

wis:hasHabitat a owl:ObjectProperty ; rdfs:domain wis:Zone ; rdfs:range wis:Habitat .
wis:inCountry  a owl:ObjectProperty ; rdfs:domain wis:Zone ; rdfs:range wis:Country .

wis:locatedIn  a owl:ObjectProperty ; rdfs:domain wis:CameraTrap ; rdfs:range wis:Zone .
wis:capturedBy a owl:ObjectProperty ; rdfs:domain wis:Sighting ; rdfs:range wis:CameraTrap .
wis:inZone     a owl:ObjectProperty ; rdfs:domain wis:Sighting ; rdfs:range wis:Zone .
wis:ofTaxon    a owl:ObjectProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range wis:Taxon .

wis:triggeredBy  a owl:ObjectProperty ; rdfs:domain wis:Alert ; rdfs:range wis:Sighting .
wis:hasPriority  a owl:ObjectProperty ; rdfs:domain wis:Alert ; rdfs:range wis:AlertPriority .
wis:concernsZone a owl:ObjectProperty ; rdfs:domain wis:Alert ; rdfs:range wis:Zone .

# --------------------------------------------------------- data properties
wis:scientificName a owl:DatatypeProperty ; rdfs:range xsd:string .
wis:statusRank     a owl:DatatypeProperty ; rdfs:domain wis:ConservationStatus ; rdfs:range xsd:integer ;
    rdfs:comment "Ordinal severity: LC=0 ... CR=4, EX=6. Lets rules compare statuses."@en .
wis:statusSource   a owl:DatatypeProperty ; rdfs:domain wis:Taxon ; rdfs:range xsd:string .
wis:confidence     a owl:DatatypeProperty ; rdfs:domain wis:Sighting ; rdfs:range xsd:decimal .
wis:observedAt     a owl:DatatypeProperty ; rdfs:domain wis:Sighting ; rdfs:range xsd:dateTime .
wis:lat            a owl:DatatypeProperty ; rdfs:range xsd:decimal .
wis:lon            a owl:DatatypeProperty ; rdfs:range xsd:decimal .
wis:zoneType       a owl:DatatypeProperty ; rdfs:domain wis:Zone ; rdfs:range xsd:string .
wis:priorityRank   a owl:DatatypeProperty ; rdfs:domain wis:AlertPriority ; rdfs:range xsd:integer .
wis:wcsLabel       a owl:DatatypeProperty ; rdfs:domain wis:Taxon ; rdfs:range xsd:string ;
    rdfs:comment "Label used in the LILA WCS camera-trap dataset; links classifier output to the KG."@en .
# Multilingual names use rdfs:label with language tags (en, ms, zh, ta);
# they double as a glossary for the NLLB translation evaluation.

# ------------------------------------------------- controlled vocabularies
wis:EX a wis:ConservationStatus ; rdfs:label "Extinct"@en ;                 wis:statusRank 6 .
wis:EW a wis:ConservationStatus ; rdfs:label "Extinct in the Wild"@en ;     wis:statusRank 5 .
wis:CR a wis:ConservationStatus ; rdfs:label "Critically Endangered"@en ;   wis:statusRank 4 .
wis:EN a wis:ConservationStatus ; rdfs:label "Endangered"@en ;              wis:statusRank 3 .
wis:VU a wis:ConservationStatus ; rdfs:label "Vulnerable"@en ;              wis:statusRank 2 .
wis:NT a wis:ConservationStatus ; rdfs:label "Near Threatened"@en ;         wis:statusRank 1 .
wis:LC a wis:ConservationStatus ; rdfs:label "Least Concern"@en ;           wis:statusRank 0 .
wis:DD a wis:ConservationStatus ; rdfs:label "Data Deficient"@en ;          wis:statusRank -1 .
wis:NE a wis:ConservationStatus ; rdfs:label "Not Evaluated"@en ;           wis:statusRank -1 .

wis:lowland_forest       a wis:Habitat ; rdfs:label "Lowland dipterocarp forest"@en .
wis:hill_montane_forest  a wis:Habitat ; rdfs:label "Hill and montane forest"@en .
wis:secondary_forest     a wis:Habitat ; rdfs:label "Secondary forest"@en .
wis:peat_swamp           a wis:Habitat ; rdfs:label "Peat swamp forest"@en .
wis:mangrove             a wis:Habitat ; rdfs:label "Mangrove"@en .
wis:wetland              a wis:Habitat ; rdfs:label "Freshwater wetland"@en .
wis:forest_edge          a wis:Habitat ; rdfs:label "Forest edge and grassland"@en .
wis:urban_green          a wis:Habitat ; rdfs:label "Urban green space"@en .

wis:poaching                a wis:Threat ; rdfs:label "Poaching and snaring"@en .
wis:illegal_wildlife_trade  a wis:Threat ; rdfs:label "Illegal wildlife trade"@en .
wis:habitat_loss            a wis:Threat ; rdfs:label "Habitat loss and fragmentation"@en .
wis:roadkill                a wis:Threat ; rdfs:label "Road collisions"@en .
wis:human_wildlife_conflict a wis:Threat ; rdfs:label "Human-wildlife conflict"@en .

wis:SG a wis:Country ; rdfs:label "Singapore"@en .
wis:MY a wis:Country ; rdfs:label "Peninsular Malaysia"@en .

wis:HIGH   a wis:AlertPriority ; rdfs:label "High"@en ;   wis:priorityRank 3 .
wis:MEDIUM a wis:AlertPriority ; rdfs:label "Medium"@en ; wis:priorityRank 2 .
wis:LOW    a wis:AlertPriority ; rdfs:label "Low"@en ;    wis:priorityRank 1 .

# ------------------------------------------------- rule engine vocabulary
# Used by rules.py (SPARQL forward chaining, stratified).
wis:ReviewTask a owl:Class ; rdfs:label "Review task"@en ;
    rdfs:comment "A sighting a human must check before it can drive alerts (low confidence or implausible)."@en .
wis:Config a owl:Class ; rdfs:label "Rule configuration"@en .
wis:config a wis:Config .

wis:predictedTaxon a owl:ObjectProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range wis:Taxon ;
    rdfs:comment "Raw classifier output, before any reasoning."@en .
wis:refinedFrom a owl:ObjectProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range wis:Taxon ;
    rdfs:comment "Set when a rule refined a species-level prediction to a subspecies using location."@en .
wis:evidence     a owl:ObjectProperty ; rdfs:domain wis:Alert ; rdfs:range wis:Sighting .
wis:suppressedBy a owl:ObjectProperty ; rdfs:domain wis:Alert ; rdfs:range wis:Alert ;
    rdfs:comment "Conflict resolution: a higher-priority alert for the same triggering event."@en .

wis:verified       a owl:DatatypeProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range xsd:boolean .
wis:issue          a owl:DatatypeProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range xsd:string .
wis:reviewReason   a owl:DatatypeProperty ; rdfs:domain wis:ReviewTask ; rdfs:range xsd:string .
wis:firedRule      a owl:DatatypeProperty ; rdfs:domain wis:Alert ; rdfs:range xsd:string .
wis:reason         a owl:DatatypeProperty ; rdfs:domain wis:Alert ; rdfs:range xsd:string .
wis:epochHours     a owl:DatatypeProperty ; rdfs:domain wis:Sighting ; rdfs:range xsd:decimal .
wis:hourOfDay      a owl:DatatypeProperty ; rdfs:domain wis:Sighting ; rdfs:range xsd:integer .
wis:reviewThreshold  a owl:DatatypeProperty ; rdfs:domain wis:Config ; rdfs:range xsd:decimal .
wis:alertWindowHours a owl:DatatypeProperty ; rdfs:domain wis:Config ; rdfs:range xsd:decimal .
wis:recordCount    a owl:DatatypeProperty ; rdfs:comment "Number of supporting GBIF records (reconcile.py)."@en .
wis:runnerUpTaxon  a owl:ObjectProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range wis:Taxon ;
    rdfs:comment "The classifier's second-ranked species. Used to route uncertain sightings to review (rule C4)."@en .
wis:runnerUpConfidence a owl:DatatypeProperty ; rdfs:domain wis:AnimalSighting ; rdfs:range xsd:decimal .
wis:reviewRunnerUp a owl:DatatypeProperty ; rdfs:domain wis:Config ; rdfs:range xsd:boolean ;
    rdfs:comment "If true, a low-confidence sighting whose runner-up species is threatened goes to review."@en .
